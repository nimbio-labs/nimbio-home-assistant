{
  "domain": "nimbio",
  "name": "Nimbio",
  "after_dependencies": ["cloud"],
  "codeowners": ["@nimbio-labs"],
  "config_flow": true,
  "dependencies": ["webhook"],
  "documentation": "https://github.com/nimbio-labs/nimbio-home-assistant",
  "integration_type": "hub",
